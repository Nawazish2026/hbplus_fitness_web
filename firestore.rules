rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOfficial() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.size() < 200
        && request.auth.token.email.matches('^[^@\\s]+@[Hh][Bb][Pp][Ll][Uu][Ss]\\.[Ff][Ii][Tt]$');
    }

    function isOwner(userId) {
      return isOfficial() && request.auth.uid == userId;
    }

    function hasAdminClaim() {
      return request.auth.token.keys().hasAll(['role']) && request.auth.token.role == 'admin';
    }

    function isAdmin() {
      return isOfficial() && hasAdminClaim();
    }

    function claimedRole() {
      return hasAdminClaim() ? 'admin' : 'user';
    }

    function isSafePhoto(url) {
      return url == null
        || (url is string && url.size() < 2048 && url.matches('^https://.+'));
    }

    function hasProfileShape(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'role', 'emailVerified', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'emailVerified', 'createdAt', 'updatedAt', 'lastLoginAt'])
        && data.uid is string
        && data.email is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.emailVerified == true
        && (data.role == 'admin' || data.role == 'user')
        && isSafePhoto(data.photoURL)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('lastLoginAt' in data) || data.lastLoginAt == null || data.lastLoginAt is timestamp);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(userId)
        && hasProfileShape(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == claimedRole()
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(userId)
        && hasProfileShape(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
