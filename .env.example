# Public client configuration. Copy to .env and fill from the Firebase console.
# Never commit .env, service account keys, or OAuth client secrets.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Web client ID from the same Google Cloud project. Required for Android and iOS.
# Firebase Auth uses it to verify the Google ID token.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional native client IDs. iOS can also read GoogleService-Info.plist.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Local emulators only. Ignored in production bundles.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=8080

# Server only. Used by `npm run set-role`. Do not prefix with EXPO_PUBLIC_.
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
